@using MealApp.Services
@inject LocalizationService L

<div class="auth-screen">
  <div class="auth-brand">
    <svg class="brand-mark" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M6 14L20 6L34 14V32C34 33.1 33.1 34 32 34H8C6.9 34 6 33.1 6 32V14Z" stroke="currentColor" stroke-width="2.5" stroke-linejoin="round"/>
      <path d="M6 14L20 22L34 14" stroke="currentColor" stroke-width="2.5" stroke-linejoin="round"/>
      <path d="M20 22V34" stroke="currentColor" stroke-width="2.5"/>
    </svg>
    <span class="brand-name">@L.T("brand.name")</span>
  </div>

  <div class="auth-card">
    <div class="auth-title">@L.T("resetpw.title")</div>

    <input class="auth-input" type="password" placeholder="@L.T("resetpw.newPasswordPlaceholder")" @bind="_password" @bind:event="oninput" />
    <input class="auth-input" type="password" placeholder="@L.T("resetpw.confirmPlaceholder")" @bind="_confirm" @bind:event="oninput" @onkeydown="OnKeyDown" />

    @if (_error != null)
    {
      <div class="auth-error">@_error</div>
    }

    <button class="auth-btn-primary" disabled="@_busy" @onclick="Submit">
      @(_busy ? L.T("common.moment") : L.T("resetpw.saveButton"))
    </button>
  </div>
</div>

@code {
    [Parameter] public AuthService Auth { get; set; } = default!;
    [Parameter] public EventCallback OnDone { get; set; }

    private string _password = "";
    private string _confirm = "";
    private string? _error;
    private bool _busy;

    private async Task OnKeyDown(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await Submit();
    }

    private async Task Submit()
    {
        if (string.IsNullOrWhiteSpace(_password) || _password.Length < 6)
        {
            _error = L.T("resetpw.tooShort");
            return;
        }
        if (_password != _confirm)
        {
            _error = L.T("resetpw.mismatch");
            return;
        }

        _busy = true;
        _error = null;
        var err = await Auth.UpdatePasswordAsync(_password);
        _busy = false;

        if (err != null) { _error = err; return; }
        await OnDone.InvokeAsync();
    }
}

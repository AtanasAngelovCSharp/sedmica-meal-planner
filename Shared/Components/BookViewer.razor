@using MealApp.Models
@using MealApp.Services
@inject LocalizationService L
@inject IJSRuntime JS

<div class="book-viewer-header">
  <span class="book-viewer-title">@(Title ?? L.T("recipebook.title"))</span>
  <span class="book-viewer-page-count">@(Recipes.Count == 0 ? "0/0" : $"{_index + 1}/{Recipes.Count}")</span>
  @if (ShowClose)
  {
    <button class="modal-close" aria-label="@L.T("common.close")" @onclick="RequestClose">✕</button>
  }
</div>

@if (Recipes.Count == 0)
{
  <div class="recipe-empty">@(EmptyText ?? L.T("recipebook.defaultEmptyText"))</div>
}
else
{
  var safeIndex = Math.Min(_index, Recipes.Count - 1);
  <div class="book-stage">
    @if (_flipping && _incomingIndex < Recipes.Count)
    {
      <div class="book-spread flip-out-@_flipDir">
        <BookSpread Name="@Recipes[safeIndex].Name" Data="@Recipes[safeIndex].Data" />
      </div>
      <div class="book-spread flip-in-@_flipDir">
        <BookSpread Name="@Recipes[_incomingIndex].Name" Data="@Recipes[_incomingIndex].Data" />
      </div>
    }
    else
    {
      <div class="book-spread">
        <BookSpread Name="@Recipes[safeIndex].Name" Data="@Recipes[safeIndex].Data" />
      </div>
    }
  </div>

  <div class="book-viewer-nav">
    <button class="book-nav-arrow" aria-label="@L.T("book.prevPage")" disabled="@(safeIndex == 0 || _flipping)" @onclick="Prev">‹</button>
    <div class="book-viewer-actions">
      @if (Actions != null)
      {
        @Actions(Recipes[safeIndex])
      }
    </div>
    <button class="book-nav-arrow" aria-label="@L.T("book.nextPage")" disabled="@(safeIndex == Recipes.Count - 1 || _flipping)" @onclick="Next">›</button>
  </div>
}

@code {
    [Parameter] public List<(string Name, RecipeData Data)> Recipes { get; set; } = new();
    // Null (not a hardcoded Bulgarian default) so a caller that forgets to
    // pass these falls back through L.T(...) in the markup above instead of
    // silently showing Bulgarian regardless of the chosen UI language.
    [Parameter] public string? Title { get; set; }
    [Parameter] public string? EmptyText { get; set; }
    [Parameter] public bool ShowClose { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public RenderFragment<(string Name, RecipeData Data)>? Actions { get; set; }

    private const int FlipMs = 460; // keep in sync with the flip keyframes' duration in style.css

    private int _index;
    private int _incomingIndex;
    private bool _flipping;
    private string _flipDir = "next";
    private bool? _reducedMotion;

    protected override void OnParametersSet()
    {
        if (_index >= Recipes.Count) _index = Math.Max(0, Recipes.Count - 1);
    }

    private async Task RequestClose() => await OnClose.InvokeAsync();

    private async Task<int> FlipDelayMsAsync()
    {
        // Cached after the first check — prefers-reduced-motion doesn't
        // change mid-session, and this runs on every page turn.
        _reducedMotion ??= await JS.InvokeAsync<bool>("mealAppInterop.prefersReducedMotion");
        return _reducedMotion == true ? 0 : FlipMs;
    }

    private async Task Prev()
    {
        if (_flipping || _index <= 0) return;
        _incomingIndex = _index - 1;
        _flipDir = "prev";
        _flipping = true;
        await Task.Delay(await FlipDelayMsAsync());
        _index = Math.Clamp(_incomingIndex, 0, Math.Max(0, Recipes.Count - 1));
        _flipping = false;
    }

    private async Task Next()
    {
        if (_flipping || _index >= Recipes.Count - 1) return;
        _incomingIndex = _index + 1;
        _flipDir = "next";
        _flipping = true;
        await Task.Delay(await FlipDelayMsAsync());
        _index = Math.Clamp(_incomingIndex, 0, Math.Max(0, Recipes.Count - 1));
        _flipping = false;
    }
}

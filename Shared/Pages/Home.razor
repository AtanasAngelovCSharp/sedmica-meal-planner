@page "/"
@using MealApp.Components
@using MealApp.Services
@using MealApp.Models
@inject AppState State
@inject AuthService Auth
@inject LocalizationService L
@inject NavigationManager Nav
@implements IDisposable

@if (!_langInitialized)
{
  <div class="auth-screen"></div>
}
else if (!L.LanguageChosen)
{
  <LanguagePicker L="L" />
}
else if (!_authRestored)
{
  <div class="auth-screen"></div>
}
else if (_passwordRecovery)
{
  <ResetPasswordScreen Auth="Auth" OnDone="() => _passwordRecovery = false" />
}
else if (!Auth.IsLoggedIn)
{
  <AuthTab Auth="Auth" />
}
else if (State.CurrentHouseholdId == null)
{
  <HouseholdOnboarding State="State" />
}
else if (!State.HasAccess)
{
  <PaywallScreen State="State" />
}
else
{
  <div class="app">

    <header class="app-header">
      <div class="brand">
        <svg class="brand-mark" aria-hidden="true" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M6 14L20 6L34 14V32C34 33.1 33.1 34 32 34H8C6.9 34 6 33.1 6 32V14Z" stroke="currentColor" stroke-width="2.5" stroke-linejoin="round"/>
          <path d="M6 14L20 22L34 14" stroke="currentColor" stroke-width="2.5" stroke-linejoin="round"/>
          <path d="M20 22V34" stroke="currentColor" stroke-width="2.5"/>
        </svg>
        <span class="brand-name">Седмица<span class="accent-dot">.</span></span>
      </div>
      <div class="week-nav">
        <button class="week-btn" aria-label="@L.T("week.prev")" @onclick="PreviousWeek">‹</button>
        <span class="week-label" aria-live="polite">@State.WeekLabel</span>
        <button class="week-btn" aria-label="@L.T("week.next")" @onclick="NextWeek">›</button>
      </div>
    </header>

    <div class="data-source-bar @BadgeClass" aria-live="polite">@State.DataSourceMessage</div>

    <main class="tab-content">

      <section class="tab-panel @(ActiveTab == "tab-meal" ? "active" : "")">
        <MealPlanTab State="State" />
      </section>

      <section class="tab-panel @(ActiveTab == "tab-shopping" ? "active" : "")">
        <ShoppingListTab State="State" />
      </section>

      <section class="tab-panel @(ActiveTab == "tab-pantry" ? "active" : "")">
        <PantryTab State="State" />
      </section>

      @if (PromotionsEnabled)
      {
        <section class="tab-panel @(ActiveTab == "tab-prices" ? "active" : "")">
          <PricesTab State="State" />
        </section>
      }

      <section class="tab-panel @(ActiveTab == "tab-recipes" ? "active" : "")">
        <RecipeBookTab State="State" />
      </section>

      <section class="tab-panel @(ActiveTab == "tab-profile" ? "active" : "")">
        <ProfileTab State="State" Auth="Auth" />
      </section>

    </main>

    <nav class="bottom-nav">
      <button class="nav-btn @(ActiveTab == "tab-meal" ? "active" : "")" @onclick='() => SetTab("tab-meal")'>
        <svg aria-hidden="true" viewBox="0 0 24 24" fill="none"><rect x="3" y="5" width="18" height="16" rx="2" stroke="currentColor" stroke-width="1.8"/><path d="M3 10H21" stroke="currentColor" stroke-width="1.8"/><path d="M8 3V7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/><path d="M16 3V7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
        <span>@L.T("nav.meal")</span>
      </button>
      <button class="nav-btn @(ActiveTab == "tab-shopping" ? "active" : "")" @onclick='() => SetTab("tab-shopping")'>
        <svg aria-hidden="true" viewBox="0 0 24 24" fill="none"><path d="M4 8H20L19 20H5L4 8Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><path d="M8 8V6C8 4 9.5 2.5 12 2.5C14.5 2.5 16 4 16 6V8" stroke="currentColor" stroke-width="1.8"/></svg>
        <span>@L.T("nav.shopping")</span>
      </button>
      <button class="nav-btn @(ActiveTab == "tab-pantry" ? "active" : "")" @onclick='() => SetTab("tab-pantry")'>
        <svg aria-hidden="true" viewBox="0 0 24 24" fill="none"><rect x="4" y="3" width="16" height="18" rx="1.5" stroke="currentColor" stroke-width="1.8"/><path d="M4 9H20" stroke="currentColor" stroke-width="1.8"/><path d="M4 15H20" stroke="currentColor" stroke-width="1.8"/></svg>
        <span>@L.T("nav.pantry")</span>
      </button>
      @if (PromotionsEnabled)
      {
        <button class="nav-btn @(ActiveTab == "tab-prices" ? "active" : "")" @onclick='() => SetTab("tab-prices")'>
          <svg aria-hidden="true" viewBox="0 0 24 24" fill="none"><path d="M12 2L3 8V12C3 17 6.5 20.7 12 22C17.5 20.7 21 17 21 12V8L12 2Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><path d="M9 12L11 14L15 10" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
          <span>@L.T("nav.prices")</span>
        </button>
      }
      <button class="nav-btn @(ActiveTab == "tab-recipes" ? "active" : "")" @onclick='() => SetTab("tab-recipes")'>
        <svg aria-hidden="true" viewBox="0 0 24 24" fill="none"><path d="M4 4.5C4 3.7 4.7 3 5.5 3H17C18.1 3 19 3.9 19 5V21L15 18.5L11 21L7 18.5L4 20.5V4.5Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><path d="M8 8H15" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/><path d="M8 11.5H15" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
        <span>@L.T("nav.recipes")</span>
      </button>
      <button class="nav-btn @(ActiveTab == "tab-profile" ? "active" : "")" @onclick='() => SetTab("tab-profile")'>
        <svg aria-hidden="true" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="8" r="4" stroke="currentColor" stroke-width="1.8"/><path d="M4 21C4 16.5 7.5 14 12 14C16.5 14 20 16.5 20 21" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
        <span>@L.T("nav.profile")</span>
      </button>
    </nav>

  </div>
}

@code {
    // Hidden until at least 3-4 store chains have real (non-null) prices in the API.
    private const bool PromotionsEnabled = false;

    private string ActiveTab = "tab-meal";
    private bool _langInitialized;
    private bool _authRestored;
    private bool _passwordRecovery;

    private string BadgeClass => State.DataSource switch
    {
        DataSourceState.Supabase => "is-supabase",
        DataSourceState.Error => "is-error",
        _ => "",
    };

    protected override async Task OnInitializedAsync()
    {
        // All three marshal through InvokeAsync — several AppState calls are
        // themselves fire-and-forget (e.g. `_ = SyncMealPlanToSupabaseAsync(...)`),
        // so their eventual OnChange can't be assumed to still be running on
        // the renderer's captured SynchronizationContext by the time it fires.
        State.OnChange += HandleStateChanged;
        L.OnChange += HandleStateChanged;
        Auth.OnAuthChanged += HandleAuthChanged;

        await L.InitializeAsync();
        _langInitialized = true;

        await TryHandlePasswordRecoveryAsync();

        if (!_passwordRecovery)
        {
            await Auth.RestoreSessionAsync();
            if (Auth.IsLoggedIn) await State.InitializeAsync();
        }
        _authRestored = true;
    }

    // A "reset password" email link lands here as
    // #access_token=...&refresh_token=...&expires_in=...&type=recovery
    // (GoTrue's implicit recovery flow) — pull those out of the fragment,
    // adopt them as the session, and show the "set new password" screen.
    private async Task TryHandlePasswordRecoveryAsync()
    {
        var fragment = new Uri(Nav.Uri).Fragment;
        if (!fragment.Contains("type=recovery")) return;

        var pars = ParseFragmentParams(fragment);
        if (!pars.TryGetValue("access_token", out var accessToken) ||
            !pars.TryGetValue("refresh_token", out var refreshToken))
        {
            return;
        }
        var expiresIn = pars.TryGetValue("expires_in", out var ei) && int.TryParse(ei, out var parsed) ? parsed : 3600;

        var err = await Auth.EstablishRecoverySessionAsync(accessToken, refreshToken, expiresIn);
        if (err == null) _passwordRecovery = true;

        // Scrub the tokens from the visible URL either way.
        Nav.NavigateTo(new Uri(Nav.Uri).GetLeftPart(UriPartial.Path), replace: true);
    }

    private static Dictionary<string, string> ParseFragmentParams(string fragment)
    {
        var result = new Dictionary<string, string>();
        foreach (var pair in fragment.TrimStart('#').Split('&', StringSplitOptions.RemoveEmptyEntries))
        {
            var idx = pair.IndexOf('=');
            if (idx < 0) continue;
            result[Uri.UnescapeDataString(pair[..idx])] = Uri.UnescapeDataString(pair[(idx + 1)..]);
        }
        return result;
    }

    private void HandleStateChanged() => InvokeAsync(StateHasChanged);

    private void HandleAuthChanged()
    {
        _ = InvokeAsync(async () =>
        {
            if (Auth.IsLoggedIn) await State.InitializeAsync();
            StateHasChanged();
        });
    }

    private void SetTab(string tab) => ActiveTab = tab;

    private async Task PreviousWeek() => await State.GoToPreviousWeekAsync();
    private async Task NextWeek() => await State.GoToNextWeekAsync();

    public void Dispose()
    {
        State.OnChange -= HandleStateChanged;
        L.OnChange -= HandleStateChanged;
        Auth.OnAuthChanged -= HandleAuthChanged;
    }
}

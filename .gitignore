# .NET build output
bin/
obj/
*.user
.vs/

# Publish output
publish_out/
publish_output/

# Supabase CLI local state/cache (machine-specific, not project source)
**/supabase/.temp/
superbase/

# Netlify local state
.netlify/

# OS junk
Thumbs.db
.DS_Store

# Android release signing — the upload keystore and its passwords must never
# be committed. keystore.local.props holds the actual values; Maui.csproj
# only references it conditionally.
*.keystore
*.jks
Maui/keystore.local.props
